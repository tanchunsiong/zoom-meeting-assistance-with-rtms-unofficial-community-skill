ZOOM_SECRET_TOKEN=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
PORT=3000

# AI processing interval in milliseconds (default: 30000 = 30 seconds)
AI_PROCESSING_INTERVAL_MS=30000

# AI function stagger delay in milliseconds (default: 5000 = 5 seconds)
AI_FUNCTION_STAGGER_MS=5000

# OpenClaw notifications
OPENCLAW_NOTIFY_CHANNEL="whatsapp"
OPENCLAW_NOTIFY_TARGET=""

# RTMS Audio streaming mode: 1 = AUDIO_MIXED_STREAM, 2 = AUDIO_MULTI_STREAMS
AUDIO_DATA_OPT=2
